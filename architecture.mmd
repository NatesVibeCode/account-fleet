flowchart TD
    %% 1. Input & Task Contract Definition
    subgraph S1 ["1. Input & Task Contract"]
        RAW["Raw Source Data\n(CSV, JSONL, Tickets, Documents)"]
        TASK["Task Specification\n(Target Schema, Extraction Instructions, Min Quote Length)"]
        PACK["Document Slicer & Batch Packer\n(Splits into source slices & bounded batches)"]
        RAW --> PACK
        TASK --> PACK
    end

    %% 2. Resilient Work Queue
    subgraph S2 ["2. Resilient Work Queue"]
        QUEUE[("Resumable Task Queue\n(SQLite Checkpoint Ledger)")]
        PACK -->|"Enqueue Bounded Batches"| QUEUE
        LEASE["Worker Lease Coordinator\n(Atomic leases & stale-worker recovery)"]
        QUEUE <-->|"Lease pending batch / Checkpoint state"| LEASE
    end

    %% 3. Fleet Dispatcher & Intelligence
    subgraph S3 ["3. Fleet Dispatcher & Intelligence"]
        POLICY{"Policy & Safety Filter\n(Zero-Cost, Privacy/ZDR,\nSpend Ceilings, Provider Rules)"}
        SCORER["Intelligent Route Scorer\n(Bayesian ranking by historical success,\ngrounding accuracy & latency)"]
        LEASE --> POLICY
        POLICY -->|"Admitted Route Candidates"| SCORER
        SCORER -->|"Select Best Available Lane"| DISPATCH["Worker Dispatcher"]
    end

    %% 4. Free & Local LLM Worker Pool
    subgraph S4 ["4. Free & Local LLM Worker Pool"]
        DISPATCH --> ROUTER{"Route Execution"}
        ROUTER -->|"Local Private Lanes"| M_LOCAL["Local Models\n(Ollama, LM Studio, vLLM)"]
        ROUTER -->|"Zero-Cost Cloud Lanes"| M_FREE["Free Tier Cloud APIs\n(OpenRouter :free, OpenCode)"]
        ROUTER -->|"Fast Cloud Endpoints"| M_CLOUD["Specialized Cloud Endpoints\n(Groq, Cerebras, Custom APIs)"]
    end

    %% 5. Deterministic Trust Boundary
    subgraph S5 ["5. Deterministic Trust Boundary"]
        GATE{"Deterministic Verification Gate"}
        M_LOCAL -->|"Raw Model Output"| GATE
        M_FREE -->|"Raw Model Output"| GATE
        M_CLOUD -->|"Raw Model Output"| GATE

        V_SCHEMA["1. Closed Schema Conformance\n(Rejects extra/missing fields & type drift)"]
        V_QUOTE["2. Verbatim Quote Grounding\n(Exact character-level substring matching)"]
        V_PRICE["3. Price Receipt Audit\n(Zero-cost verification & spend limits)"]

        GATE --> V_SCHEMA
        V_SCHEMA -->|"Schema Valid"| V_QUOTE
        V_QUOTE -->|"Quote Grounded"| V_PRICE
    end

    %% 6. Adaptive Feedback & Self-Healing
    subgraph S6 ["6. Adaptive Feedback & Self-Healing"]
        FAIL_ROTATE["Route Failover & Demotion\n(Demote failing model score, rotate batch to next lane)"]
        RATE_COOL["Rate-Limit Cooldown\n(Non-destructive backoff, zero attempt burn)"]
        PRICE_TRIP["Cost Circuit Breaker\n(Unexpected charge trips breaker & disables route)"]
    end

    V_SCHEMA -.->|"Malformed JSON / Schema Drift"| FAIL_ROTATE
    V_QUOTE -.->|"Fabricated / Altered Quote"| FAIL_ROTATE
    GATE -.->|"Rate Limit (429) / Transient (5xx)"| RATE_COOL
    V_PRICE -.->|"Unexpected Charge on Free Route"| PRICE_TRIP

    FAIL_ROTATE -->|"Retry batch on alternative model"| QUEUE
    RATE_COOL -->|"Re-queue batch with cooldown delay"| QUEUE
    PRICE_TRIP -->|"Disable violating route"| POLICY

    %% 7. Verified Output & Audit Trail
    subgraph S7 ["7. Verified Output & Audit Trail"]
        COMMIT["Commit Verified Results\n(Record tokens, latency & route proof)"]
        V_PRICE -->|"All Checks Passed"| COMMIT
        COMMIT --> QUEUE
        
        OUT_JSON["Self-Validating Packet\n(Clean JSON with embedded TaskSpec & Proofs)"]
        OUT_CSV["Flat Tabular CSV\n(Verified claims & source quote citations)"]
        AUDIT["Immutable Audit Ledger\n(Complete history of attempts, costs & routes)"]
        
        QUEUE -->|"Export Finished Run"| OUT_JSON
        QUEUE -->|"Export Finished Run"| OUT_CSV
        QUEUE -->|"Audit Inspection"| AUDIT
    end
